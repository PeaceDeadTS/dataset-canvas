NODE_ENV=development
# Unix socket in production, e.g. /tmp/dataset-canvas.sock
LISTEN_SOCKET=
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me

DB_USER=
DB_PASSWORD=
DB_DATABASE=dataset_canvas
# DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock
DB_HOST=localhost
DB_PORT=3306

# Empty = backend/uploads relative to process cwd
UPLOADS_DIR=
# Empty = rewrite legacy hosts using the app default public media base
PUBLIC_MEDIA_BASE=
